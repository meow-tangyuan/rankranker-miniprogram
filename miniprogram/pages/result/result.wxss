page {
  background: #FAF3E0;
}

.result-container {
  padding: 60rpx 30rpx;
  padding-bottom: 180rpx;
}

/* ========== 标题区 ========== */
.result-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.trophy-wrap {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFD700, #FF6A00);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 106, 0, 0.3);
}

.trophy-icon {
  font-size: 52rpx;
  display: block;
}

.header-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #4A3728;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #B8A898;
  letter-spacing: 1rpx;
}

/* ========== Top 3 领奖台 ========== */
.top3-section {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 56rpx;
  padding: 0 10rpx;
}

.top-card {
  flex: 1;
  border-radius: 28rpx;
  padding: 36rpx 16rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  overflow: hidden;
}

/* 卡片内装饰光晕 */
.top-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  opacity: 0.15;
  pointer-events: none;
}

.rank-1 {
  flex: 1.3;
  background: linear-gradient(160deg, #FFD700 0%, #FF8C00 100%);
  padding-top: 56rpx;
  padding-bottom: 56rpx;
  z-index: 2;
  box-shadow: 0 12rpx 40rpx rgba(255, 140, 0, 0.35);
  border: 2rpx solid rgba(255, 215, 0, 0.5);
}

.rank-1::before {
  background: #FFF8DC;
}

.rank-2 {
  background: linear-gradient(160deg, #E8E8E8 0%, #B8B8B8 100%);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.12);
  border: 2rpx solid rgba(192, 192, 192, 0.4);
}

.rank-2::before {
  background: #fff;
}

.rank-3 {
  background: linear-gradient(160deg, #E8A86D 0%, #CD7F32 100%);
  box-shadow: 0 8rpx 28rpx rgba(205, 127, 50, 0.25);
  border: 2rpx solid rgba(205, 127, 50, 0.4);
}

.rank-3::before {
  background: #FFE4B5;
}

/* 排名徽章 */
.rank-badge {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 26rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.gold-badge {
  background: linear-gradient(135deg, #FFF8DC, #FFD700);
  color: #8B6914;
  box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

.silver-badge {
  background: linear-gradient(135deg, #fff, #C0C0C0);
  color: #666;
  box-shadow: 0 4rpx 12rpx rgba(192, 192, 192, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

.bronze-badge {
  background: linear-gradient(135deg, #FFE4B5, #CD7F32);
  color: #6B3A00;
  box-shadow: 0 4rpx 12rpx rgba(205, 127, 50, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
}

.top-cover {
  width: 140rpx;
  height: 200rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  background: rgba(0, 0, 0, 0.1);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.25);
  position: relative;
  z-index: 1;
}

.rank-1 .top-cover {
  width: 180rpx;
  height: 260rpx;
}

.top-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 6rpx;
  display: block;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.25);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
  position: relative;
  z-index: 1;
}

.top-subtitle {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 12rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
  position: relative;
  z-index: 1;
}

/* Top3 胜率进度条 */
.top-score-bar-wrap {
  width: 80%;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.25);
  margin-bottom: 10rpx;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.top-score-bar {
  height: 100%;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.7);
  transition: width 0.6s ease-out;
}

.top-score-bar.gold-bar {
  background: rgba(255, 255, 255, 0.85);
}

.top-score-bar.bronze-bar {
  background: rgba(255, 255, 255, 0.65);
}

.top-score {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  position: relative;
  z-index: 1;
}

/* ========== 列表区 ========== */
.list-section, .unplayed-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4A3728;
  margin-bottom: 24rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid;
  border-image: linear-gradient(180deg, #FF6A00, #00FFC3) 1;
  letter-spacing: 1rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  transition: transform 0.15s;
}

.rank-item:active {
  transform: scale(0.98);
}

.rank-num {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #8C7B6B;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-num.top-rank {
  background: linear-gradient(135deg, #FF6A00, #F5B52B);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 106, 0, 0.2);
}

.rank-num.gray {
  background: rgba(0, 0, 0, 0.04);
  color: #B8A898;
}

.rank-cover {
  width: 80rpx;
  height: 110rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #F0E8D8;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  gap: 8rpx;
}

.rank-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #4A3728;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-sub {
  font-size: 24rpx;
  color: #8C7B6B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 列表内胜率进度条 */
.rank-score-bar-wrap {
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.rank-score-bar {
  height: 100%;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #00FFC3, #12CB8D);
  transition: width 0.6s ease-out;
}

.rank-score {
  font-size: 28rpx;
  font-weight: bold;
  color: #00C896;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ========== 底部操作栏 ========== */
.result-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: rgba(250, 243, 224, 0.92);
  backdrop-filter: blur(10px);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  padding-bottom: env(safe-area-inset-bottom);
  gap: 24rpx;
}

.footer-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.btn-secondary {
  background: rgba(0, 0, 0, 0.05);
  color: #8C7B6B;
}

.btn-secondary:active {
  background: rgba(0, 0, 0, 0.1);
}

.btn-primary {
  background: linear-gradient(135deg, #FF6A00, #F5B52B);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(255, 106, 0, 0.25);
}

.btn-primary:active {
  opacity: 0.9;
}

/* ========== 社交裂变 ========== */
.social-section {
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.social-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  text-align: center;
}

.btn-share {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.25);
}

.btn-challenge {
  background: linear-gradient(135deg, #f093fb, #f5576c);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(245, 87, 108, 0.25);
}

.btn-compare {
  background: linear-gradient(135deg, #4facfe, #00f2fe);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(79, 172, 254, 0.25);
}

.challenge-tip {
  text-align: center;
  font-size: 26rpx;
  color: #B8A898;
  padding: 20rpx;
}

/* ========== 海报弹窗 ========== */
.poster-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
}

.poster-content {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  width: 100%;
  max-width: 600rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.poster-image {
  width: 100%;
  border-radius: 16rpx;
  display: block;
  margin-bottom: 24rpx;
  background: #f5f5f5;
}

.poster-actions {
  display: flex;
  gap: 20rpx;
}

.poster-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.btn-save {
  background: linear-gradient(135deg, #FF6A00, #F5B52B);
  color: #fff;
}

.btn-close {
  background: rgba(0, 0, 0, 0.05);
  color: #8C7B6B;
}

/* 隐藏 canvas */
.poster-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 1300px;
}
