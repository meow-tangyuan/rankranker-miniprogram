page { background: #FAF3E0; }

.compare-container {
  padding: 40rpx 30rpx;
  padding-bottom: 160rpx;
}

.compare-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.compare-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #4A3728;
  display: block;
  margin-bottom: 12rpx;
}

.compare-subtitle {
  font-size: 28rpx;
  color: #B8A898;
}

.similarity-card {
  background: linear-gradient(135deg, #FF6A00, #F5B52B);
  border-radius: 32rpx;
  padding: 48rpx;
  text-align: center;
  margin-bottom: 48rpx;
  box-shadow: 0 12rpx 40rpx rgba(255, 106, 0, 0.25);
}

.similarity-ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.similarity-num {
  font-size: 64rpx;
  font-weight: 800;
  color: #fff;
}

.verdict-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 12rpx;
}

.similarity-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.compare-list-section { margin-bottom: 40rpx; }

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4A3728;
  margin-bottom: 24rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid;
  border-image: linear-gradient(180deg, #FF6A00, #00FFC3) 1;
}

.compare-table-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid rgba(0,0,0,0.06);
  margin-bottom: 16rpx;
}

.header-rank { width: 60rpx; font-size: 22rpx; color: #B8A898; text-align: center; }
.header-user { flex: 1; font-size: 22rpx; color: #B8A898; text-align: center; }
.header-vs { width: 60rpx; text-align: center; font-size: 22rpx; color: #FF6A00; }

.compare-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.rank-col { width: 60rpx; text-align: center; }
.rank-num {
  width: 44rpx; height: 44rpx; line-height: 44rpx;
  background: rgba(0,0,0,0.05); border-radius: 12rpx;
  font-size: 24rpx; font-weight: 700; color: #8C7B6B;
  display: inline-block;
}
.rank-num.top-rank {
  background: linear-gradient(135deg, #FF6A00, #F5B52B);
  color: #fff;
}

.user-col {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 16rpx; border-radius: 16rpx;
  background: rgba(255,255,255,0.5); margin: 0 8rpx;
}
.user-col.common-item {
  background: rgba(255, 106, 0, 0.08);
  border: 1rpx solid rgba(255, 106, 0, 0.2);
}

.compare-cover { width: 80rpx; height: 110rpx; border-radius: 12rpx; margin-bottom: 12rpx; background: #F0E8D8; }
.compare-name { font-size: 24rpx; color: #4A3728; text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
.common-tag { font-size: 20rpx; color: #FF6A00; margin-top: 8rpx; font-weight: bold; }

.vs-col { width: 60rpx; text-align: center; }
.vs-line { font-size: 24rpx; color: #B8A898; }

.common-section { margin-bottom: 40rpx; }
.common-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.common-card {
  width: calc(33.33% - 14rpx);
  background: rgba(255,255,255,0.6); border-radius: 20rpx;
  padding: 20rpx; text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}
.common-cover { width: 100%; height: 140rpx; border-radius: 12rpx; margin-bottom: 12rpx; background: #F0E8D8; }
.common-title { font-size: 24rpx; color: #4A3728; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.compare-footer {
  position: fixed; bottom: 0; left: 0; right: 0; height: 120rpx;
  background: rgba(250, 243, 224, 0.92); backdrop-filter: blur(10rpx);
  display: flex; align-items: center; justify-content: center;
  padding: 0 40rpx; padding-bottom: env(safe-area-inset-bottom);
}

.footer-btn {
  width: 100%; height: 80rpx; line-height: 80rpx;
  border-radius: 40rpx; font-size: 28rpx; font-weight: bold; border: none;
  background: linear-gradient(135deg, #FF6A00, #F5B52B);
  color: #fff; box-shadow: 0 6rpx 20rpx rgba(255, 106, 0, 0.25);
}
