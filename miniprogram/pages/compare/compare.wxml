<view class="compare-container">
  <view class="compare-header">
    <text class="compare-title">「{{title}}」</text>
    <text class="compare-subtitle">品味对决结果</text>
  </view>

  <!-- 等待状态 -->
  <view class="waiting-card" wx:if="{{showWaiting}}">
    <text class="waiting-icon">⏳</text>
    <text class="waiting-title">好友尚未完成挑战</text>
    <text class="waiting-desc">请稍后再来查看对比结果</text>
    <button class="footer-btn btn-primary" bindtap="goHome">返回首页</button>
  </view>

  <block wx:if="{{!showWaiting}}">
    <view class="similarity-card">
      <view class="similarity-ring">
        <text class="similarity-num">{{similarity}}%</text>
      </view>
      <text class="verdict-text">{{verdict}}</text>
      <text class="similarity-desc">Top 10 重合度</text>
    </view>

    <view class="compare-list-section">
      <view class="section-title">Top 10 对比</view>
      <view class="compare-table-header">
        <text class="header-rank">排名</text>
        <text class="header-user">发起者</text>
        <text class="header-vs">VS</text>
        <text class="header-user">挑战者</text>
      </view>

      <!-- ✅ FIX #11: 使用 compareList，安全处理 null -->
      <view class="compare-item" wx:for="{{compareList}}" wx:key="index">
        <view class="rank-col">
          <text class="rank-num {{item.rank <= 3 ? 'top-rank' : ''}}">{{item.rank}}</text>
        </view>

        <!-- 发起者 -->
        <view class="user-col {{item.inviter && item.inviter.isCommon ? 'common-item' : ''}}">
          <block wx:if="{{item.inviter}}">
            <image class="compare-cover" src="{{item.inviter.cover}}" mode="aspectFill" />
            <text class="compare-name">{{item.inviter.title}}</text>
            <text wx:if="{{item.inviter.isCommon}}" class="common-tag">重合</text>
          </block>
          <block wx:else>
            <view class="empty-slot">—</view>
          </block>
        </view>

        <view class="vs-col"><text class="vs-line">—</text></view>

        <!-- 挑战者 -->
        <view class="user-col {{item.invitee && item.invitee.isCommon ? 'common-item' : ''}}">
          <block wx:if="{{item.invitee}}">
            <image class="compare-cover" src="{{item.invitee.cover}}" mode="aspectFill" />
            <text class="compare-name">{{item.invitee.title}}</text>
            <text wx:if="{{item.invitee.isCommon}}" class="common-tag">重合</text>
          </block>
          <block wx:else>
            <view class="empty-slot">—</view>
          </block>
        </view>
      </view>
    </view>

    <view class="common-section" wx:if="{{commonList.length > 0}}">
      <view class="section-title">共同喜爱</view>
      <view class="common-grid">
        <view class="common-card" wx:for="{{commonList}}" wx:key="index">
          <image class="common-cover" src="{{item.cover}}" mode="aspectFill" />
          <text class="common-title">{{item.title}}</text>
        </view>
      </view>
    </view>

    <view class="compare-footer">
      <button class="footer-btn btn-primary" bindtap="goHome">我也要玩</button>
    </view>
  </block>
</view>
